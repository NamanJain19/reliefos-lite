# RELIEFOS Lite Backend Environment Configuration Example
PROJECT_NAME="RELIEFOS Lite API"
VERSION="1.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8013
ALLOWED_ORIGINS="http://localhost:3012,http://127.0.0.1:3012"

# Database Configuration (SQLAlchemy)
# - In production (ENVIRONMENT=production), PostgreSQL is strictly required for concurrency.
#   Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# - In development (ENVIRONMENT=development), SQLite is used by default: sqlite:///./reliefos_lite.db
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/reliefos_lite
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=reliefos_lite
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Optimization Engine & Algorithmic Parameters
OR_TOOLS_TIME_LIMIT_SECS=30
EPSILON_TOLERANCE=0.00
HYDROLOGIC_CLEARANCE_THRESHOLD_M=0.35

# AI Infrastructure Configuration (Backend-Only Credentials)
# Options: "mock" (offline default), "gemini", "openai"
AI_PROVIDER=mock

# Google Gemini Settings (API key never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI or OpenAI-Compatible (Ollama, vLLM, OpenRouter, Azure)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# AI Resilience & Safety Policies
AI_TIMEOUT_SECONDS=15.0
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=30
AI_TEMPERATURE=0.2

# Authentication & Production Security
# ENVIRONMENT: "development", "testing", "staging", "production"
# - In production (ENVIRONMENT=production or DEBUG=False):
#   JWT_SECRET is strictly mandatory (minimum 32 characters, cryptographically random).
#   Startup fails safely if missing or insecure. Insecure defaults are rejected.
#   AUTH_STRICT is auto-enforced to True. Pre-shared tokens are disabled.
# - In development (ENVIRONMENT=development, DEBUG=True):
#   JWT_SECRET can be omitted for convenient local fallback.
ENVIRONMENT=development
AUTH_ENABLED=True
AUTH_STRICT=False
JWT_SECRET=your_high_entropy_production_jwt_secret_min_32_chars_here
TOKEN_EXPIRY_HOURS=24

